# Direct Kavenegar Verify Lookup delivery for Payload customer OTP authentication.
# The approved template must contain %token.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=npgroup-login

# Public site origin used for metadata and sitemap URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS and its local development PostgreSQL database
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_DB_NAME=nilper_payload
PAYLOAD_DB_USER=nilper_payload
PAYLOAD_DB_PASSWORD=
