# Direct Kavenegar Verify Lookup delivery for Payload customer OTP authentication.
# The approved template must contain %token.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=npgroup-login

# Public site origin used for metadata and sitemap URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zarinpal server-side payment configuration. Never expose the merchant ID through NEXT_PUBLIC_*.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Tapin shipping configuration. All values are server-only; never prefix them with NEXT_PUBLIC_.
# TAPIN_AUTHORIZATION must contain the complete Authorization header value supplied by Tapin.
# Confirm TAPIN_AMOUNT_UNIT with Tapin (rial or toman) before enabling live parcel quotes.
TAPIN_AUTHORIZATION=
TAPIN_SHOP_ID=
TAPIN_EMPLOYEE_CODE=
TAPIN_KIOSK_ID=
TAPIN_ORIGIN_PROVINCE_CODE=
TAPIN_ORIGIN_CITY_CODE=
TAPIN_PACKAGING_WEIGHT_GRAMS=
TAPIN_REGISTER_TYPE=
TAPIN_AMOUNT_UNIT=

# Payload CMS and its local development PostgreSQL database
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_DB_NAME=nilper_payload
PAYLOAD_DB_USER=nilper_payload
PAYLOAD_DB_PASSWORD=
