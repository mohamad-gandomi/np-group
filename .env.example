# Supabase SSR authentication and Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Only used to sign local development sessions when Supabase is not configured.
AUTH_DEV_SECRET=

# Used by the Supabase Send SMS Hook, not by the Next.js application directly.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=npgroup-login
SEND_SMS_HOOK_SECRET=

# Public site origin used for metadata and sitemap URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
