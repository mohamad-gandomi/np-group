{
  "name": "npgroup-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:payload": "npm run payload:db:start && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:journal": "node scripts/journal.test.mjs",
    "test:showcase": "node scripts/showcase.test.mjs",
    "payload": "payload",
    "payload:generate": "payload generate:types && payload generate:importmap",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate": "payload migrate",
    "payload:seed": "payload run src/payload/seed.ts",
    "payload:verify:phase3": "payload run src/payload/verify-phase3.ts",
    "payload:verify:phase4": "payload run src/payload/verify-phase4.ts",
    "payload:verify:phase5": "payload run src/payload/verify-phase5.ts",
    "payload:verify:manual-catalog": "payload run src/payload/verify-manual-catalog.ts",
    "payload:db:start": "docker compose --env-file .env.local -f payload.compose.yaml up -d",
    "payload:db:stop": "docker compose --env-file .env.local -f payload.compose.yaml down",
    "payload:db:status": "docker compose --env-file .env.local -f payload.compose.yaml ps"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-ecommerce": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
